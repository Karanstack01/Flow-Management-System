# ---- Shared ----
DATABASE_URL=postgresql://fms:fms@localhost:5432/fms?schema=public
REDIS_URL=redis://localhost:6379

# ---- API ----
API_PORT=4000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
# Encrypts the secrets entered in Settings > Connections (Cloudinary, Google/Microsoft mail, WhatsApp).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONNECTIONS_SECRET_KEY=change-me-32-byte-base64-key
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
CORS_ORIGINS=http://localhost:5173
# Files stored on the server. The worker reads the same folder (email attachments), so use an
# ABSOLUTE path shared by both — a relative path resolves inside each app's own folder.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
# Public URL of the web app, used in notification deep links
APP_URL=http://localhost:5173
# Trust X-Forwarded-For only when the API is reachable through the reverse proxy alone (true | false | proxy IPs)
TRUST_PROXY=true
# Webhooks / WhatsApp may not call private network addresses. Set true only on-premise.
# ALLOW_PRIVATE_OUTBOUND=true

# ---- Worker: email ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FMS <no-reply@example.com>"

# ---- Worker: WhatsApp (generic HTTP provider; leave empty to disable) ----
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# ---- Seed ----
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe!2026
